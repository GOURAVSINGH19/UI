{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "web",
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "portfolio",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "../../Portfolio",
        "dev",
        "--port",
        "3001"
      ],
      "port": 3001
    }
  ]
}